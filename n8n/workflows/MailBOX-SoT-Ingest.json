{
  "name": "MailBOX SoT Ingest (account-agnostic)",
  "id": "MlbxSoTIngest001",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "sot-sched-0001",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] }
      }
    },
    {
      "id": "sot-fetch-0001",
      "name": "Fetch Ingest Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [220, 0],
      "parameters": {
        "method": "GET",
        "url": "http://mailbox-dashboard:3001/dashboard/api/internal/gmail/ingest-batch?limit=25",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "sot-split-0001",
      "name": "Split Messages",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": { "fieldToSplitOut": "messages", "options": {} }
    },
    {
      "id": "sot-insert-001",
      "name": "Insert Inbox (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [660, 0],
      "parameters": {
        "method": "POST",
        "url": "http://mailbox-dashboard:3001/dashboard/api/internal/inbox-messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message_id\": {{ JSON.stringify($json.message_id || \"\") }},\n  \"thread_id\": {{ JSON.stringify($json.thread_id || \"\") }},\n  \"from_addr\": {{ JSON.stringify($json.from_addr || \"\") }},\n  \"to_addr\": {{ JSON.stringify($json.to_addr || \"\") }},\n  \"subject\": {{ JSON.stringify($json.subject || \"\") }},\n  \"received_at\": {{ JSON.stringify($json.received_at || \"\") }},\n  \"snippet\": {{ JSON.stringify($json.snippet || \"\") }},\n  \"body\": {{ JSON.stringify($json.body || \"\") }},\n  \"in_reply_to\": {{ JSON.stringify($json.in_reply_to || \"\") }},\n  \"references\": {{ JSON.stringify($json.references || \"\") }},\n  \"account_email\": {{ JSON.stringify($json.account_email || \"\") }}\n}",
        "options": { "timeout": 15000 }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "sot-ifnew-0001",
      "name": "Only If Newly Inserted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "sot-cond-00000001",
              "leftValue": "={{ $json.created }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sot-classify-01",
      "name": "Run Classify Sub",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1100, 0],
      "parameters": {
        "options": {},
        "workflowId": { "__rl": true, "mode": "id", "value": "MlbxClsfySub0001" }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every 5 Minutes": { "main": [[{ "node": "Fetch Ingest Batch", "type": "main", "index": 0 }]] },
    "Fetch Ingest Batch": { "main": [[{ "node": "Split Messages", "type": "main", "index": 0 }]] },
    "Split Messages": { "main": [[{ "node": "Insert Inbox (HTTP)", "type": "main", "index": 0 }]] },
    "Insert Inbox (HTTP)": { "main": [[{ "node": "Only If Newly Inserted", "type": "main", "index": 0 }]] },
    "Only If Newly Inserted": { "main": [[{ "node": "Run Classify Sub", "type": "main", "index": 0 }], []] }
  }
}
